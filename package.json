{
  "name": "@yuuinih/mindbug-lab",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/ruleset-build.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/build-ruleset.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm test",
    "demo": "npm run build && node dist/src/demo.js",
    "demo:pet": "npm run build && node dist/src/pet-duel/demo.js",
    "demo:strike": "npm run build && node dist/src/pet-duel/strike-demo.js"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@yuuinih/turn-kernel": "file:../turn-kernel"
  }
}
